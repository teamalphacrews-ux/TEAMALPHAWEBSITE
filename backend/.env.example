PORT=5000
MONGO_URI=your_mongodb_uri
JWT_SECRET=your_jwt_secret
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_password

# Google Sheets API Config
GOOGLE_CLIENT_EMAIL=your_service_account_email
GOOGLE_PRIVATE_KEY="your_private_key"
GOOGLE_SHEET_ID=your_sheet_id

# Google OAuth 2.0 Config
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
# Gmail read-only mailbox: enable Gmail API and add this separate OAuth redirect.
# Uses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET unless BOTH Gmail overrides are set.
GMAIL_REDIRECT_URI=http://localhost:5000/api/integrations/gmail/callback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Public frontend origin. Production requires the real HTTPS website origin.
# Quote/invoice links and Google OAuth redirects use this value.
FRONTEND_URL=http://localhost:5173

# Webhook URL
WEBHOOK_URL=your_webhook_url

# Inbound enquiries: random secret of at least 32 characters, no whitespace.
# Leave blank to disable; configure privately on the backend and trusted sender.
ENQUIRY_WEBHOOK_SECRET=

# Vault Encryption
# Stable 32 raw UTF-8 bytes or canonical base64 of 32 bytes (Render Generate).
VAULT_SECRET=your_vault_secret
# Optional separate stable 32-byte encryption key for business-record backups.
# When blank, VAULT_SECRET is used. Retain the key while encrypted backups exist.
BACKUP_SECRET=
# Optional canonical backend HTTPS origin for uploaded studio logos in documents.
API_PUBLIC_URL=

# Production: set NODE_ENV=production in the hosting provider, not in client code.
# Keep the existing database and JWT/vault secrets when updating a live service.
# Configure GOOGLE_REDIRECT_URI as the backend HTTPS /api/auth/google/callback
# URL and WEBHOOK_URL as the backend HTTPS /api/auth/google/webhook URL.

# Optional SMTP service for quote/invoice delivery and scheduled email.
# Without SMTP_HOST, EMAIL_USER / EMAIL_PASS use the existing Gmail transport.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional existing system-admin login. Prefer the studio's existing accounts.
# Configure both privately only if the deployed service already uses this login.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Frontend website gateway credentials belong to the FRONTEND Node service.
# WEBSITE_ENQUIRY_WEBHOOK_SECRET there must match ENQUIRY_WEBHOOK_SECRET here.
# Never enable STUDIO_LOCAL_PREVIEW or publish local sample-data fixtures.

# Select exactly one backend provider: meta or wabb. Omitted defaults to meta.
# For an existing Wabb account, set wabb; do not reconnect or migrate its number.
WHATSAPP_PROVIDER=meta

# Wabb server API. Keep keys private; never put them in VITE_* variables.
# API verification confirms key access only, not live phone/app connectivity.
WABB_API_KEY=
WABB_WORKSPACE_ID=
# Full international number including +, matching the existing Wabb account.
WABB_PHONE_NUMBER=
# Wabb's public API does not document a full inbox/history/status callback stream.
# No Wabb inbound callback is enabled by these settings. Manual submissions only.

# WhatsApp Business Cloud API. Backend only; leave blank when using Wabb.
# Keep the existing WhatsApp Business app and number. Verify coexistence through
# the supported Meta onboarding flow; this integration never registers/migrates it.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Set a Graph API version supported by the Meta app, including the v prefix.
WHATSAPP_GRAPH_VERSION=
# Meta callback: API_PUBLIC_URL + /api/integrations/whatsapp/webhook (HTTPS).
# Verify token must match WHATSAPP_VERIFY_TOKEN; subscribe to messages events.
# Never put access tokens or app secrets in VITE_* variables or Studio profile.

# Commercial Studio OS social sign-in. These are NEW identity-only OAuth clients;
# do not reuse/replace Calendar or Gmail credentials. All values stay on backend.
# Personal Team Alpha deployment: keep both false. SaaS APIs are not mounted.
# Enable only for a separately approved commercial product release.
SAAS_ENABLED=false
SAAS_SIGNUP_ENABLED=false
SAAS_GOOGLE_CLIENT_ID=
SAAS_GOOGLE_CLIENT_SECRET=
# Exact registered backend callback: https://api.example.com/api/saas/oauth/google/callback
SAAS_GOOGLE_REDIRECT_URI=
# Apple web Service ID, Team ID, Key ID and Sign in with Apple private .p8 key.
# A multiline PEM or a value with literal \n separators is accepted.
SAAS_APPLE_CLIENT_ID=
SAAS_APPLE_TEAM_ID=
SAAS_APPLE_KEY_ID=
SAAS_APPLE_PRIVATE_KEY=
# Apple requires a registered public HTTPS domain; localhost/IP callbacks cannot work.
# https://api.example.com/api/saas/oauth/apple/callback
SAAS_APPLE_REDIRECT_URI=

# Optional native iOS push. Keep disabled until Apple signing and APNs are configured.
APNS_ENABLED=false
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY=
APNS_SANDBOX=false
PUSH_TOKEN_SECRET=
