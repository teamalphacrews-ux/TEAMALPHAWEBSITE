PORT=5000
MONGO_URI=your_mongodb_uri
JWT_SECRET=your_jwt_secret
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_password

# Google Sheets API Config
GOOGLE_CLIENT_EMAIL=your_service_account_email
GOOGLE_PRIVATE_KEY="your_private_key"
GOOGLE_SHEET_ID=your_sheet_id

# Google OAuth 2.0 Config
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
# Public frontend origin. Production requires the real HTTPS website origin.
# Quote/invoice links and Google OAuth redirects use this value.
FRONTEND_URL=http://localhost:5173

# Webhook URL
WEBHOOK_URL=your_webhook_url

# Inbound enquiries: random secret of at least 32 characters, no whitespace.
# Leave blank to disable; configure privately on the backend and trusted sender.
ENQUIRY_WEBHOOK_SECRET=

# Vault Encryption
VAULT_SECRET=your_vault_secret

# Production: set NODE_ENV=production in the hosting provider, not in client code.
# Keep the existing database and JWT/vault secrets when updating a live service.
# Configure GOOGLE_REDIRECT_URI as the backend HTTPS /api/auth/google/callback
# URL and WEBHOOK_URL as the backend HTTPS /api/auth/google/webhook URL.

# Optional SMTP service for quote/invoice delivery and scheduled email.
# Without SMTP_HOST, EMAIL_USER / EMAIL_PASS use the existing Gmail transport.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional existing system-admin login. Prefer the studio's existing accounts.
# Configure both privately only if the deployed service already uses this login.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Frontend website gateway credentials belong to the FRONTEND Node service.
# WEBSITE_ENQUIRY_WEBHOOK_SECRET there must match ENQUIRY_WEBHOOK_SECRET here.
# Never enable STUDIO_LOCAL_PREVIEW or publish local sample-data fixtures.
