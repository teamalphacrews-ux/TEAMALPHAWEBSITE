# PUBLIC BUILD VARIABLES: included in browser JavaScript; never put secrets here.
# Local Vite: leave empty so /api and /socket.io use its port-5000 proxy.
# Production with two hosts: REQUIRED real backend HTTPS origin, without /api.
# Set this in the host's build environment; never ship localhost or a placeholder.
VITE_API_URL=

# Optional canonical public HTTPS website origin for metadata, without a path.
VITE_SITE_ORIGIN=

# FRONTEND NODE SERVER ONLY: set privately in the hosting provider.
# Production requires NODE_ENV=production and the real HTTPS public origin.
# The production server reads process.env; it does not load this file itself.
WEBSITE_PUBLIC_ORIGIN=

# Required for website enquiry delivery into the existing backend CRM webhook.
# URL must end in /api/webhooks/enquiries. Use HTTPS in production.
# Secret must match backend ENQUIRY_WEBHOOK_SECRET (32+ characters, no spaces).
WEBSITE_ENQUIRY_WEBHOOK_URL=
WEBSITE_ENQUIRY_WEBHOOK_SECRET=

# Optional real Google reviews. No rating/reviews are invented when unconfigured.
# Restrict the server-only Places API (New) key; use the verified studio Place ID.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
WEBSITE_REVIEWS_ENABLED=true

# Optional approved public publication manifest. File takes precedence over URL.
# URL requires exact allowed hostnames, separated by commas. Never use a DB dump.
WEBSITE_CONTENT_FILE=
WEBSITE_CONTENT_URL=
WEBSITE_CONTENT_ALLOWED_HOSTS=

# Do not add VITE_ prefixes to any server-only value above.
# See WEBSITE-CONFIGURATION.md and ../docs/PRODUCTION_RELEASE.md.
